# Copy to .env on the server. Never commit .env.
FREESWITCH_VERSION=latest

# Public IP seen by SIP providers (office WAN behind pfSense)
PUBLIC_IP=188.11.43.168
# Office LAN allowed to use the internal profile (phones, softphones)
LAN_CIDR=10.10.25.0/24

# SIP ports: internal profile for LAN phones, external profile for trunks
INTERNAL_SIP_PORT=5060
EXTERNAL_SIP_PORT=5080
# RTP range: must match the pfSense port forward
RTP_START=20000
RTP_END=20999

# Generated by setup.sh if empty
DEFAULT_PASSWORD=
ESL_PASSWORD=
