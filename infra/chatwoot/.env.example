# Copy to .env on the server and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

CHATWOOT_VERSION=v4.19.1
# Address Docker publishes port 3000 on (LAN IP of the NUC, or 127.0.0.1)
LAN_BIND=127.0.0.1

FRONTEND_URL=http://10.10.25.114:3000
DEFAULT_LOCALE=it
ENABLE_ACCOUNT_SIGNUP=false

SECRET_KEY_BASE=
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Small machine (2 cores): keep workers low
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5

# Outgoing email (to configure later)
MAILER_SENDER_EMAIL=Timecly <noreply@timecly.it>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
